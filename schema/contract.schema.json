{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DAT-EDIP Data Contract (Learning)",
  "type": "object",
  "required": ["product_name", "owner", "source", "target", "primary_key", "columns"],
  "properties": {
    "product_name": { "type": "string" },
    "description": { "type": "string" },
    "owner": {
      "type": "object",
      "required": ["developer_name"],
      "properties": {
        "developer_name": { "type": "string" },
        "team": { "type": "string" },
        "contact_email": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["type", "path", "file_format"],
      "properties": {
        "type": { "type": "string", "enum": ["volume"] },
        "catalog": { "type": "string" },
        "schema": { "type": "string" },
        "volume_name": { "type": "string" },
        "path": { "type": "string" },
        "file_format": { "type": "string" },
        "options": { "type": "object" }
      }
    },
    "target": {
      "type": "object",
      "required": ["volume", "raw", "stage"],
      "properties": {
        "volume": { "type": "object" },
        "raw": { "type": "object" },
        "stage": { "type": "object" },
        "quarantine": { "type": "object" }
      }
    },
    "primary_key": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "data_type", "nullable"],
        "properties": {
          "name": { "type": "string" },
          "data_type": { "type": "string" },
          "nullable": { "type": "boolean" },
          "trim": { "type": "boolean" }
        }
      }
    },
    "validations": { "type": "object" }
  }
}
